<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fitsSystemWindows="true"> <!-- 关键：让系统自动避开顶部状态栏 -->

    <!-- 顶部标题 (增加一点顶部内边距，让文字不要贴太紧) -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#FFFFFF"
        android:gravity="center"
        android:text="甜品外卖"
        android:textColor="#FF9800"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- 店铺列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_shop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tv_title"
        android:layout_above="@id/layout_float_cart"
        android:padding="8dp" />

    <!-- 首页底部悬浮购物车栏 -->
    <LinearLayout
        android:id="@+id/layout_float_cart"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="#333333"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/tv_float_total"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="购物车是空的"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_float_checkout"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_orange"
            android:gravity="center"
            android:text="去结算"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</RelativeLayout>