<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- 顶部店铺信息 (简化版) -->
    <LinearLayout
        android:id="@+id/layout_shop_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tv_detail_shop_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333"/>
        <TextView
            android:id="@+id/tv_detail_announcement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FF9800"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- 商品列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layout_shop_head"
        android:layout_above="@id/layout_cart_bar" />

    <!-- 底部购物车结算栏 -->
    <LinearLayout
        android:id="@+id/layout_cart_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="#333333"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/tv_cart_total"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="¥0.0"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_checkout"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:backgroundTint="#FF9800"
            android:text="去结算"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</RelativeLayout>